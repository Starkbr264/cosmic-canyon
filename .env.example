# ===== Banco (Postgres 16) =====
POSTGRES_USER=tradewind
POSTGRES_PASSWORD=tradewind_dev
POSTGRES_DB=tradewind
# 5433 e 8081 evitam colisao com outros projetos que ja ocupam 5432/8080 na maquina.
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# ===== API (Spring Boot) =====
API_PORT=8081
SPRING_PROFILES_ACTIVE=local
# Origem liberada no CORS da API (frontend local). Dentro do Compose o navegador
# acessa http://localhost:<API_PORT>, nunca o nome do servico.
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Tamanho do pool Hikari. O total de conexoes nao pode passar de
# max_connections do Postgres (100 por padrÃ£o) dividido pelos processos.
DB_POOL_MAX_SIZE=10

# ===== Frontend (Next.js) =====
WEB_PORT=3000
# NEXT_PUBLIC_* e embutido no build: mudar aqui exige rebuild da imagem web.
NEXT_PUBLIC_API_URL=http://localhost:8081

# ===== Cache e filas (opcional) =====
# Vazio = a API funciona sem Redis. Preenchendo, ela usa para cache e fila.
REDIS_HOST=
REDIS_PORT=6379

# ===== Object storage S3-compativel (opcional) =====
# Vazio = sem upload de arquivo. No Compose o servico `objectstore` (RustFS,
# S3-compativel) e a opcao padrão; em producao, use R2 ou S3 de verdade.
#   S3_ENDPOINT=http://localhost:9000  (de dentro do container: http://objectstore:9000)
S3_ENDPOINT=
S3_BUCKET=tradewind-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PORT=9000
S3_CONSOLE_PORT=9001

# ===== Observabilidade (opcional) =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_PASSWORD=tradewind_dev

# ===== Ferramentas =====
PGADMIN_EMAIL=admin@tradewind.local
PGADMIN_PASSWORD=tradewind_dev
PGADMIN_PORT=5051

# ===== Imagem local =====
APP_VERSION=latest

# ===== Supabase (opcional, perfil `supabase`) =====
# Nao e dependencia do projeto: existe so para comparar com um Postgres gerenciado.
# Settings -> Database -> Connection string (modo Session, porta 5432)
SUPABASE_DB_URL=
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
# Settings -> API -> Project URL e anon key (usados pelo client PostgREST de exemplo)
SUPABASE_URL=
SUPABASE_ANON_KEY=
